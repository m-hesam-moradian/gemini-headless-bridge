# ── Gemini Headless Bridge configuration ─────────────────────────────
# Copy to .env and adjust. Every value has a safe default; an empty .env works.

# Port for the bridge's minimal health API (http://127.0.0.1:PORT/api/status).
# Control + monitoring is via the Telegram bot — no web UI is served.
PORT=3000
# Bind address. 127.0.0.1 keeps the bridge private to your machine.
HOST=127.0.0.1

# Where Chromium stores its persistent profile (cookies, IndexedDB, session
# tokens). Defaults to ./browser-profile next to the project. Override ONLY if
# you need it elsewhere — e.g. on a CI/build server, point it at /tmp or a
# path OUTSIDE the project tree so build tools (Next.js standalone tracing,
# Docker context, etc.) don't bundle 100+ MB of Chromium data into the
# published artifact. Leave UNSET on your own machine.
# PROFILE_DIR=/tmp/gh-bridge-profile

# Auto+probe startup: when "true" (default) and ./browser-profile already
# exists, the server boots straight into headless mode and probes Gemini so
# the Telegram bot immediately reports "authenticated & ready".
AUTO_CONNECT=true

# Auto-chain of browser channels tried in order at launch.
#   chrome    -> your real installed Google Chrome (best for Google sign-in)
#   msedge    -> installed Microsoft Edge
#   chromium  -> Playwright's bundled Chromium (requires: npx playwright install chromium)
BROWSER_CHANNELS=chrome,msedge,chromium

# Grace period (ms) after auth is detected in the visible window before it is
# closed and relaunched headless. Gives Chromium time to flush __Secure-*
# cookies and IndexedDB tokens to disk inside ./browser-profile.
AUTH_GRACE_MS=3000

# How long the auth watcher keeps checking the visible login window (ms).
AUTH_WATCH_TIMEOUT_MS=600000

# How long a headless auth probe waits for the composer to mount (ms).
PROBE_WAIT_MS=20000

# Relaunch resilience: attempts + exponential backoff (ms) when the profile is
# locked by a crashed Chromium (SingletonLock / SingletonCookie / SingletonSocket).
RELAUNCH_ATTEMPTS=5
RELAUNCH_BASE_DELAY_MS=1000
RELAUNCH_MAX_DELAY_MS=16000

# ── Telegram bot (PRIMARY controller — required for full functionality) ─
# Get a token from @BotFather. The bot uses long polling — zero open inbound
# ports, zero webhooks. It auto-captures YOUR chatId on the first /start and
# restricts all subsequent actions to that one owner.
#   1. Create a bot with @BotFather (/newbot) and copy the token here.
#   2. npm run dev
#   3. Open the bot in Telegram and send /start — it replies with the inline
#      keyboard control panel.
TELEGRAM_BOT_TOKEN=
# (optional) Your numeric Telegram chat ID. Leave empty to auto-capture on
# first /start (recommended). Set this only if you want to lock the bot to a
# specific chat BEFORE the first /start.
# TELEGRAM_CHAT_ID=

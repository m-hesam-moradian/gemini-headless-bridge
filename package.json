  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "playwright": "^1.56.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2"
  }
}

{
  "name": "gemini-headless-bridge",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Persistent-Context Headless Browser Bridge for Gemini + Local Test Host (Playwright, Express 5, TypeScript)",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
